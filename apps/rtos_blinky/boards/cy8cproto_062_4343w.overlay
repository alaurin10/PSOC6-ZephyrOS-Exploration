/*
 * Board overlay for the CY8CPROTO-062-4343W: onboard thermistor (RT1) and a
 * flash partition for persistent settings.
 *
 * Kit guide schematic (Figure A-11):
 *
 *   P10.0 ---[ R39 10k ]---+---[ RT1 NTC 10k ]--- P10.3
 *                          |
 *                      THERM_OUT -> P10.1 (ADC0 channel 1)
 *
 * Both ends of the divider are GPIOs, so the app powers the divider only
 * while measuring and can swap its polarity (see src/thermistor.c).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/adc/adc.h>

/ {
	chosen {
		/* Where the Settings subsystem (ZMS backend) keeps its data. */
		zephyr,settings-partition = &storage_partition;
	};

	/* zephyr,user is a free-form node for application-specific properties. */
	zephyr,user {
		io-channels = <&adc0 1>;
		therm-res-gpios = <&gpio_prt10 0 GPIO_ACTIVE_HIGH>;
		therm-ntc-gpios = <&gpio_prt10 3 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * Last 32 KB of the 2 MB main flash, reserved for persistent settings.
 * (The separate 32 KB work flash at 0x14000000 isn't reachable: the Infineon
 * flash driver only exposes the first flash node.) Erase/write unit is a
 * 512-byte row, so 0x8000 = 64 rows.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@1f8000 {
			label = "storage";
			reg = <0x1f8000 DT_SIZE_K(32)>;
		};
	};
};

&gpio_prt10 {
	status = "okay";
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* The Infineon driver only supports gain 1, the internal reference and 12 bits. */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <1>; /* P10.1 */
	};
};
