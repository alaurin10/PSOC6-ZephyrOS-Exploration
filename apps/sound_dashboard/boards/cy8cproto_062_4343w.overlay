/*
 * Board overlay for the CY8CPROTO-062-4343W.
 *
 * - Onboard thermistor (RT1) and the timer that paces its sampling
 *   (same wiring as apps/rtos_blinky, kit guide Figure A-11):
 *
 *     P10.0 ---[ R39 10k ]---+---[ RT1 NTC 10k ]--- P10.3
 *                            |
 *                        THERM_OUT -> P10.1 (ADC0 channel 1)
 *
 * - The PDM microphones: one PDM data line (P10.5) shared by a left and a
 *   right microphone, clocked from P10.4 by the audio subsystem's PDM-PCM
 *   converter (driver in ext/drivers/audio), and the audio clock it runs from.
 *
 * - A flash partition for persistent settings (UI state, Wi-Fi credentials).
 *
 * P0.4 is both the SW0 button and the Wi-Fi host-wake interrupt line in the
 * board devicetree. The AIROC Wi-Fi driver owns it, so this app never uses SW0.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/adc/adc.h>

/ {
	aliases {
		dmic0 = &pdm0;
	};

	chosen {
		/* Where the Settings subsystem (ZMS backend) keeps its data. */
		zephyr,settings-partition = &storage_partition;
	};

	/* zephyr,user is a free-form node for application-specific properties. */
	zephyr,user {
		io-channels = <&adc0 1>;
		therm-res-gpios = <&gpio_prt10 0 GPIO_ACTIVE_HIGH>;
		therm-ntc-gpios = <&gpio_prt10 3 GPIO_ACTIVE_HIGH>;
		/* Hardware timer that paces thermistor sampling. */
		sample-counter = <&counter0_0>;
	};

	soc {
		/* AUDIOSS0 PDM-to-PCM converter (not in the SoC devicetree). */
		pdm0: pdm@40a00000 {
			compatible = "infineon,cat1a-pdm";
			reg = <0x40a00000 0x1000>;
			interrupts = <157 6>; /* audioss_0_interrupt_pdm */
			clocks = <&clk_hf1>;
			/* The PDM's DMA request is wired to DataWire 1 channel 26. */
			dmas = <&dma1 26>;
			dma-names = "rx";
			pinctrl-0 = <&p10_4_pdm_clk &p10_5_pdm_data>;
			pinctrl-names = "default";
			status = "okay";
		};
	};
};

/*
 * Audio clock: PLL0 (path 1, fed from the 8 MHz IMO) at 24.576 MHz, a multiple
 * of every standard audio rate, drives CLK_HF1 for the audio subsystem.
 * The PLL gets as close as its dividers allow (24.571 MHz, -0.02 %).
 */
&pll0 {
	clock-frequency = <24576000>;
	status = "okay";
};

&clk_hf1 {
	clocks = <&pll0>;
	clock-div = <1>;
	status = "okay";
};

&pinctrl {
	p10_4_pdm_clk: p10_4_pdm_clk {
		pinmux = <DT_CAT1_PINMUX(10, 4, HSIOM_SEL_ACT_9)>; /* audioss[0].pdm_clk */
		drive-push-pull;
	};

	p10_5_pdm_data: p10_5_pdm_data {
		pinmux = <DT_CAT1_PINMUX(10, 5, HSIOM_SEL_ACT_9)>; /* audioss[0].pdm_data */
		input-enable;
	};
};

/* TCPWM0 counter 0 (already enabled by the board): 1 MHz, so one tick = 1 us. */
&counter0_0 {
	clock-frequency = <1000000>;
};

/*
 * Last 32 KB of the 2 MB main flash, reserved for persistent settings.
 * Erase/write unit is a 512-byte row, so 0x8000 = 64 rows.
 */
&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		storage_partition: partition@1f8000 {
			label = "storage";
			reg = <0x1f8000 DT_SIZE_K(32)>;
		};
	};
};

&gpio_prt10 {
	status = "okay";
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* The Infineon driver only supports gain 1, the internal reference and 12 bits. */
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
		zephyr,input-positive = <1>; /* P10.1 */
	};
};
