# Application options for the sound dashboard.

mainmenu "Sound dashboard"

menu "Audio capture"

config APP_AUDIO_SAMPLE_RATE
	int "Microphone sample rate (Hz)"
	default 16000
	range 8000 48000

config APP_AUDIO_BLOCK_SAMPLES
	int "Samples per capture block"
	default 512
	help
	  The microphone is read in blocks of this many samples; each block is
	  analyzed as it arrives (512 samples = 32 ms at 16 kHz). Must be a
	  power of two.

config APP_AUDIO_BLOCK_COUNT
	int "Capture blocks"
	default 8
	help
	  Blocks in the capture memory slab: two are being filled by the
	  driver, the rest absorb delays in the analysis thread.

choice APP_AUDIO_MIC
	prompt "Microphone"
	default APP_AUDIO_MIC_LEFT

config APP_AUDIO_MIC_LEFT
	bool "Left channel of the PDM line"

config APP_AUDIO_MIC_RIGHT
	bool "Right channel of the PDM line"

endchoice

config APP_AUDIO_GAIN_DB
	int "PDM converter gain (dB)"
	default 0
	range -12 10
	help
	  Applied by the PDM-PCM converter in 1.5 dB steps.

config APP_AUDIO_REC_SECONDS
	int "Raw audio recorder length (s), 0 = no recorder"
	default 0
	range 0 20
	help
	  For tuning the analysis offline: "mic rec" records this many seconds
	  of raw samples into RAM (32 KB per second at 16 kHz) with the user
	  LED on, and GET /api/rec.wav downloads them as a WAV file. Enable it
	  with the rec.conf fragment.

endmenu

menu "Data log"

config APP_DATALOG_SYNC_S
	int "Seconds between syncs to flash"
	default 10
	range 1 300
	help
	  Lines are buffered in RAM and committed to the file this often; a
	  power cut loses at most this much of the log.

config APP_DATALOG_FILE_KB
	int "Start a new log file after this many KB"
	default 1024
	help
	  About 64 bytes per second are logged, so 1024 KB is roughly 4.5
	  hours. Each file takes whole 256 KB erase blocks on the flash.

config APP_DATALOG_FILES
	int "Log files to keep"
	default 8
	help
	  When a new file starts, the oldest ones are deleted to keep this many.
	  Files x size must leave a quarter of the 16 MB log partition free
	  for the file system (checked at build time).

endmenu

source "Kconfig.zephyr"
